#!/usr/bin/env bash
#
# dev-secrets — the secrets a `prod` cache needs on a WORKSTATION, never printed, never replacing a value
# (core-bundle, ADR-0002).
#
#   make secrets                        # vendor/bin/dev-secrets, from the project's root: into .env.prod.local
#   vendor/bin/dev-secrets .env.docker  # another file (a project whose Compose reads .env.docker)
#
# Writes, when absent or empty from the file: APP_SECRET, always fresh; MERCURE_JWT_SECRET when `.env` declares
# it; each variable the secrets guard declares (`core.secrets_guard.variables`); JWT_PASSPHRASE when LexikJWT is
# configured. For the latter, the value the workstation already uses (`.env.dev.local`, `.env.dev`, `.env.local`,
# `.env.docker`) is taken over — the Mercure hub, the storage, the JWT key pair of the local stack go with it —,
# unless the guard refuses it (empty, a recipe's placeholder, the value `.env` commits): taken over, it would
# build nothing, so a fresh one is drawn instead, and said. Without any workstation value, a fresh one — and,
# for the JWT passphrase, a regenerated pair.
#
# `.env.prod.local` by default: Symfony reads it in `prod` only, so a value drawn here never changes what the
# development stack signs or decrypts. Development only: a server's secrets are set on the server.
set -euo pipefail
cd "${PROJECT_DIR:-$PWD}"
if [ ! -f .env ]; then
    echo "dev-secrets: run it from the project's root (no .env in $PWD)." >&2
    exit 1
fi

file="${1:-.env.prod.local}"
console="${CONSOLE:-php bin/console}"
[ -f "$file" ] || : > "$file"
chmod 600 "$file"

written=()
redrawn=()
# A value set and not empty is never replaced.
missing() { ! grep -qE "^$1=.+" "$file"; }
put() {
    if grep -qE "^$1=" "$file"; then
        awk -v n="$1" -v v="$2" 'index($0, n"=") == 1 { print n"="v; next } { print }' "$file" > "$file.new"
        mv "$file.new" "$file"
    else
        if [ -s "$file" ] && [ -n "$(tail -c1 "$file")" ]; then echo >> "$file"; fi
        printf '%s=%s\n' "$1" "$2" >> "$file"
    fi
    chmod 600 "$file"
    written+=("$1")
}

# The value the workstation already uses for a variable, in the order the development stack reads them.
workstation() {
    local source
    for source in .env.dev.local .env.dev .env.local .env.docker; do
        if [ "$source" != "$file" ] && grep -qE "^$1=.+" "$source" 2>/dev/null; then
            sed -n "s/^$1=//p" "$source" | tail -1
            return
        fi
    done
}

# What the secrets guard refuses: Jul6Art\CoreBundle\Security\SecretsGuard::PLACEHOLDERS, word for word
# (Tests/Tooling/DevSecretsTest keeps the two lists equal).
placeholders() {
    case "$1" in
        APP_SECRET) printf '%s\n' 'ChangeMe' '!ChangeMe!' 'change_me' 'change_me_to_a_random_32_char_string' ;;
        MERCURE_JWT_SECRET) printf '%s\n' '!ChangeThisMercureHubJWTSecretKey!' ;;
        JWT_PASSPHRASE) printf '%s\n' 'change_me' 'change_me_jwt_passphrase' '!ChangeMe!' ;;
    esac
}
unquote() {
    local value="$1"
    case "$value" in
        "'"*"'" | '"'*'"') value="${value:1:${#value}-2}" ;;
    esac
    printf '%s' "$value"
}
# refused NAME VALUE: empty, a placeholder, or the value `.env` commits — what the guard names.
refused() {
    local value committed
    value=$(unquote "$2")
    [ -z "$value" ] && return 0
    placeholders "$1" | grep -qxF -- "$value" && return 0
    committed=$(unquote "$(sed -n "s/^$1=//p" .env | tail -1)")
    [ -n "$committed" ] && [ "$committed" = "$value" ] && return 0
    return 1
}

# fill NAME GENERATOR: the workstation's value if the guard accepts it, a fresh one otherwise.
fill() {
    missing "$1" || return 0
    local value
    value=$(workstation "$1")
    if [ -n "$value" ] && refused "$1" "$value"; then
        redrawn+=("$1")
        value=''
    fi
    if [ -z "$value" ]; then value=$($2); fi
    put "$1" "$value"
}
hex16() { openssl rand -hex 16; }
hex32() { openssl rand -hex 32; }
base64_32() { openssl rand -base64 32; }

# APP_SECRET must match nothing: always fresh, and long enough for the guard.
if missing APP_SECRET; then put APP_SECRET "$(hex16)"; fi
if grep -q '^MERCURE_JWT_SECRET=' .env; then fill MERCURE_JWT_SECRET hex32; fi

guarded=$(sed -nE 's/^[[:space:]]+variables:[[:space:]]*\[([^]]*)\].*/\1/p' config/packages/core.yaml 2>/dev/null | tr ',' ' ')
for name in $guarded; do fill "$name" base64_32; done

passphrase=''
if [ -f config/packages/lexik_jwt_authentication.yaml ] && missing JWT_PASSPHRASE; then
    if [ -n "$(workstation JWT_PASSPHRASE)" ]; then
        # The workstation's: the local key pair goes with it. Refused, a fresh one, and the pair stays.
        fill JWT_PASSPHRASE hex32
    else
        passphrase=$(hex32)
        put JWT_PASSPHRASE "$passphrase"   # none: a fresh one, and the pair is regenerated below
    fi
fi

if [ ${#written[@]} -eq 0 ]; then
    echo "$file: nothing to write, every secret already has its value."
    exit 0
fi
echo "$file: ${written[*]} (values not shown)"
if [ ${#redrawn[@]} -gt 0 ]; then
    for name in "${redrawn[@]}"; do
        echo "  $name: the workstation's value is one the secrets guard refuses (empty, a placeholder or the value .env commits): a fresh one instead. The development stack keeps its own."
        if [ "$name" = JWT_PASSPHRASE ]; then
            echo "  The local JWT key pair still goes with the development passphrase: a production run on this workstation signs no token."
        fi
    done
fi

if [ -n "$passphrase" ]; then
    case "$console" in
        *docker*)
            echo "A fresh JWT_PASSPHRASE: recreate the container (docker compose up -d), then regenerate the pair:"
            echo "    $console lexik:jwt:generate-keypair --overwrite" ;;
        *)
            JWT_PASSPHRASE="$passphrase" $console lexik:jwt:generate-keypair --overwrite --no-interaction
            echo "JWT key pair regenerated with the new passphrase." ;;
    esac
fi
